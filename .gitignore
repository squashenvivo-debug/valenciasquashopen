# Runtime content and media are stored in Supabase Storage/Postgres, never in Git.
backups/
assets/uploads/
supabase/.temp/

# Static site data required by the public pages and Pages build.
!data/
!data/*.json
!data/translations/
!data/translations/*.json

# Local Supabase and environment secrets
.env
.env.*
!.env.example
.supabase/

# Strict code-only mode: binary media must live in external storage/CDN.
assets/**/*.jpg
assets/**/*.jpeg
assets/**/*.png
assets/**/*.webp
assets/**/*.gif
assets/**/*.svg
assets/**/*.ico
