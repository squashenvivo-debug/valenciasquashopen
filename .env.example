# Public browser configuration. The anon key is safe to expose, but never commit
# service_role keys or Supabase personal access tokens.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
ASSET_CDN_BASE=

# --- Centro de Prensa IA (api/generate-news, desplegado en Vercel) ---
# Estas variables se configuran en el proyecto de Vercel (Settings > Environment Variables),
# NO en el sitio estático de GitHub Pages. SUPABASE_URL/SUPABASE_ANON_KEY se repiten aquí porque
# es un despliegue separado y necesita sus propias variables para verificar la sesión del admin.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5
ALLOWED_ORIGINS=https://psavalenciaopen.com,https://www.psavalenciaopen.com
