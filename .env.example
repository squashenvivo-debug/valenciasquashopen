# Public browser configuration. The anon key is safe to expose, but never commit
# service_role keys or Supabase personal access tokens.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
ASSET_CDN_BASE=

# --- Centro de Prensa IA (api/generate-news, desplegado en Vercel) ---
# Estas variables se configuran en el proyecto de Vercel (Settings > Environment Variables),
# NO en el sitio estático de GitHub Pages. SUPABASE_URL/SUPABASE_ANON_KEY se repiten aquí porque
# es un despliegue separado y necesita sus propias variables para verificar la sesión del admin.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5
ALLOWED_ORIGINS=https://psavalenciaopen.com,https://www.psavalenciaopen.com
PSA_TOURNAMENT_ID=12711

# --- Cloudflare R2 (api/mirror-to-r2, api/r2-presign) ---
# Bucket que sirve las fotos de galería al público (nunca cobra egress, a diferencia de
# Supabase Storage). Además de estas variables, el bucket necesita una política CORS en el
# dashboard de Cloudflare (R2 > bucket > Settings > CORS Policy) que permita PUT y GET desde
# ALLOWED_ORIGINS: sin eso, la subida directa navegador -> R2 falla en el preflight.
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://photos.psavalenciaopen.com
